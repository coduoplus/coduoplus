# Copy to .env next to docker-compose.yml and edit.

# Game files: a folder with main/ (or Main/) and uo/ holding the pk3s.
# On a Linux host: any path. From Windows/WSL: NOT a C:\ or D:\ path - see docs/DOCKER.md
# ("Game files on a Windows drive"); use a volume made by make_game_volume.sh instead.
CODUO_GAME_DIR=./game

# The 1.51b Linux binaries (coduo_lnxded + uo/game.mp.uo.i386.so), if not in CODUO_GAME_DIR.
CODUO_BINS_DIR=./bins

PORT=28960
# 2 = internet (heartbeats to the master server), 1 = LAN only
DEDICATED=2

# Use a local build instead of the published image:
# CODUOPLUS_IMAGE=coduoplus-server
